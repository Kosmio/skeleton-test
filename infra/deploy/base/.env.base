# =============================================================================
# Base Environment — shared defaults loaded before every overlay
# =============================================================================
# Override any of these in the overlay .env file.

# Project
PROJECT_SLUG=skeleton

# Docker
DOCKER_NETWORK=${PROJECT_SLUG}-network
DOCKER_REGISTRY_REPOSITORY=ghcr.io/your-org/

# Versions
POSTGRES_VERSION=15-alpine
TRAEFIK_VERSION=v3.6.1

# PostgreSQL defaults
POSTGRES_HOSTNAME=${PROJECT_SLUG}-postgres
POSTGRES_USER=strapi
POSTGRES_DB=strapi

# Strapi defaults
STRAPI_ADMIN_URL=/admin
STRAPI_INTERNAL_URL=http://${PROJECT_SLUG}-strapi:1337

# ACME (Let's Encrypt)
ACME_EMAIL=neipa@kosm.io
